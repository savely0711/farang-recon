# ─────────────────────────────────────────────────────────────
# Настройки парсера разведки. Скопировать в файл .env и заполнить.
# В git/доки/память НЕ попадает (см. .gitignore). Живёт только на сервере.
# ─────────────────────────────────────────────────────────────

# --- Telegram (технический аккаунт) ---
# API ID и HASH берутся ОДИН раз на https://my.telegram.org → API development tools
TG_API_ID=
TG_API_HASH=
# Строка сессии — её сгенерирует login.py при первом входе. Сюда вставить результат.
TG_SESSION=

# --- Google-таблица (через Apps Script Web App) ---
# Адрес скрипта-приёмника: деплой Apps Script → Web App → ссылка вида
#   https://script.google.com/macros/s/XXXXXXXX/exec
# Пока пусто — парсер работает в тестовом режиме (в таблицу не пишет).
SHEET_WEBHOOK_URL=
# Общий пароль-токен: тот же, что вшит в скрипт Apps Script (константа TOKEN).
SHEET_TOKEN=

# --- ИИ (категории) ---
ANTHROPIC_API_KEY=
# Дешёвая быстрая модель — та же, что на сайте для модерации
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
