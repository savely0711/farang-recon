# ─────────────────────────────────────────────────────────────
# Настройки парсера разведки. Скопировать в файл .env и заполнить.
# В git/доки/память НЕ попадает (см. .gitignore). Живёт только на сервере.
# ─────────────────────────────────────────────────────────────

# --- Telegram (технический аккаунт) ---
# API ID и HASH берутся ОДИН раз на https://my.telegram.org → API development tools
TG_API_ID=
TG_API_HASH=
# Строка сессии — её сгенерирует login.py при первом входе. Сюда вставить результат.
TG_SESSION=

# --- Google-таблица (через Apps Script Web App) ---
# Адрес скрипта-приёмника: деплой Apps Script → Web App → ссылка вида
#   https://script.google.com/macros/s/XXXXXXXX/exec
# Пока пусто — парсер работает в тестовом режиме (в таблицу не пишет).
SHEET_WEBHOOK_URL=
# Общий пароль-токен: тот же, что вшит в скрипт Apps Script (константа TOKEN).
SHEET_TOKEN=

# --- Сайт: авто-подготовка объявлений «согласных» (этап 4, prepare.py) ---
# Точка приёма на сайте и общий пароль-токен (то же значение — в переменных
# окружения Vercel, ключ RECON_API_TOKEN). Пусто — prepare.py не запускается.
SITE_API_URL=https://farang.market/api/recon
RECON_API_TOKEN=
# Сколько объявлений готовить за один запуск и насколько старые посты брать.
PREPARE_LIMIT=30
PREPARE_MAX_AGE_DAYS=30
PREPARE_MAX_PHOTOS=6

# --- ИИ (категории) ---
ANTHROPIC_API_KEY=
# Дешёвая быстрая модель — та же, что на сайте для модерации
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# ─────────────────────────────────────────────────────────────
# «Первое касание» — авто-отправка авторам (пункт 14, outreach.py)
# Отдельная программа на том же сервере. По умолчанию ВЫКЛЮЧЕНА.
# ─────────────────────────────────────────────────────────────
# Включить отправку (1 = слать; пусто/0 = не слать). Тест без отправки: OUTREACH_DRY=1.
OUTREACH_ENABLED=
# Сессии ОТПРАВЛЯЮЩИХ аккаунтов Савелия (2–3 рабочих). Каждую генерирует login.py
# (вход под нужным номером). Читающий аккаунт разведки (TG_SESSION) — НЕ трогаем,
# он отдельно. api_id/api_hash берутся те же (TG_API_ID / TG_API_HASH выше).
TG_SEND_SESSION_1=
TG_SEND_SESSION_2=
TG_SEND_SESSION_3=
# Дневной лимит на аккаунт с прогревом: старт → потолок, шаг в день.
OUTREACH_DAILY_START=5
OUTREACH_DAILY_MAX=18
OUTREACH_WARMUP_STEP=2
# Сколько сообщений максимум с одного аккаунта за ОДИН запуск (объём набирается
# частыми мелкими запусками из cron — по-человечески и размазано).
# ВАЖНО: даже если поставить больше 1, письма всё равно пойдут не чаще, чем
# разрешает OUTREACH_MIN_GAP_MIN ниже — темп теперь сторожит сам бот.
OUTREACH_PER_RUN=1
# ТЕМП: минимум минут между двумя письмами ОДНОГО аккаунта + случайная добавка
# (чтобы не было «как по часам»). Считается по часам бота, не по cron.
OUTREACH_MIN_GAP_MIN=25
OUTREACH_GAP_JITTER_MIN=10
# «Человеческие» часы по Бангкоку (шлём только внутри окна) и паузы перед письмом.
OUTREACH_HOURS=10-20
OUTREACH_DELAY_MIN=45
OUTREACH_DELAY_MAX=180
# Объявление моложе стольких часов не трогаем (правило «через сутки»).
OUTREACH_MIN_AGE_HOURS=24
# Текст сообщения (ссылка на объявление добавляется в конец автоматически).
# ПО УМОЛЧАНИЮ бот сам берёт случайный вариант из списка в outreach.py — так
# рассылка меньше похожа на спам. Заполнять эти строки НЕ обязательно.
# Свой набор вариантов (через «|»):
# OUTREACH_MESSAGES=Здравствуйте! Ещё актуально? |Добрый день! Объявление в силе?
# Один фиксированный текст всем (старое поведение, не рекомендуется):
# OUTREACH_MESSAGE=Здравствуйте! Ваше объявление ещё актуально?

# Кому написать в Telegram, если рассылка встала (ник Савелия, с «@»).
OUTREACH_NOTIFY_TO=
# Пауза после блокировки PeerFlood: первая, вторая подряд, третья и дальше (часы).
OUTREACH_PEERFLOOD_STEPS=6,24,72
# Что считать «подряд»: если после окончания прошлой паузы бот проработал столько
# часов без новой блокировки, счёт начинается заново с первой (6 ч).
OUTREACH_PEERFLOOD_RESET_HOURS=24
